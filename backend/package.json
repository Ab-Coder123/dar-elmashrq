{
    "name":  "@dar-elmashrq/backend",
    "version":  "0.0.1",
    "private":  true,
    "type":  "commonjs",
    "main":  "dist/server.js",
    "scripts":  {
                    "dev":  "tsx watch src/server.ts",
                    "build":  "tsc -p tsconfig.json",
                    "start":  "node dist/server.js",
                    "test":  "vitest run",
                    "type-check":  "tsc --noEmit -p tsconfig.check.json",
                    "db:migrate":  "tsx scripts/migrate.ts",
                    "admin:create":  "tsx scripts/create-admin.ts"
                },
    "dependencies":  {
                         "@dar-elmashrq/types":  "workspace:*",
                         "bcryptjs":  "^3.0.3",
                         "cors":  "^2.8.5",
                         "dotenv":  "^16.4.7",
                         "express":  "^4.21.2",
                         "helmet":  "^8.0.0",
                         "morgan":  "^1.10.0",
                         "pg":  "^8.23.1",
                         "zod":  "^3.24.2"
                     },
    "devDependencies":  {
                            "@dar-elmashrq/config":  "workspace:*",
                            "@electric-sql/pglite":  "^0.5.8",
                            "@types/cors":  "^2.8.17",
                            "@types/express":  "^4.17.21",
                            "@types/morgan":  "^1.9.9",
                            "@types/node":  "^22.13.1",
                            "@types/pg":  "^8.23.1",
                            "@types/supertest":  "^6.0.2",
                            "supertest":  "^7.0.0",
                            "tsx":  "^4.19.3",
                            "typescript":  "^5.8.3",
                            "vitest":  "^3.0.7"
                        }
}
